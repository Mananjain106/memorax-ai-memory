# Copy to .env and fill in real values. NEVER commit .env
OPENROUTER_API_KEY=sk-or-v1-...
QDRANT_API_KEY=...

# Model / collection (fallbacks tried in order on 429/provider errors)
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-sante:free
OPENROUTER_FALLBACK_MODELS=liquid/lfm-2.5-2.6b:free,google/gemma-4-26b-a4b-it:free
QDRANT_URL=https://<your-cluster>.gcp.cloud.qdrant.io
QDRANT_COLLECTION=ai_memory

# Offline local LLM
# LOCAL_LLM_RUNTIME: "transformers" (node-native ONNX, zero install) | "ollama"
LOCAL_LLM_RUNTIME=transformers
LOCAL_LLM_MODEL=Xenova/LaMini-Flan-T5-77M
LOCAL_LLM_URL=http://localhost:11434
